{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "1km-e-si-mangia.vercel.app"
        }
      ],
      "destination": "https://1kmesimangia.it/:path*",
      "permanent": true
    }
  ]
}
